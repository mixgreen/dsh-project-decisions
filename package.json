{
  "name": "@local/dsh-project-decisions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A human-seeded project decision board, backed by one Markdown file and shared with DSH agents.",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "prd", "decisions", "markdown"],
  "files": ["host.js", "store.js", "client.js", "cordis.patch.yml", "locale/en.json", "locale/zh.json", "icon.svg", "README.md", "README.en.md", "CHANGELOG.md", "LICENSE", "RELEASING.md", "CONTRIBUTING.md"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check host.js && node --check store.js && node --check client.js && node --check scripts/release.mjs",
    "verify": "npm run check && npm test && npm run release:check",
    "prepack": "npm run verify",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:pack": "node scripts/release.mjs pack"
  },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
